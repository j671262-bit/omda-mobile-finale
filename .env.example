# Configuration locale OMDA Mobile (copier vers .env et adapter selon le mode choisi).
# Les variables EXPO_PUBLIC_* sont embarquées dans l'application : ne jamais y placer de secret.
EXPO_PUBLIC_USE_MOCKS=false
EXPO_PUBLIC_USE_MOCKS_MEMBER=false
EXPO_PUBLIC_USE_MOCKS_CANDIDATE=false
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Ancienne variable pour les routes REST historiques ; non requise par les fonctions candidat Supabase raccordées.
EXPO_PUBLIC_API_BASE_URL=
